<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ==================== SECURITY GROUPS ==================== -->
        <record id="group_amnus_user" model="res.groups">
            <field name="name">AMNUS User</field>
        </record>
        <record id="group_amnus_manager" model="res.groups">
            <field name="name">AMNUS Manager</field>
            <field name="implied_ids" eval="[(4, ref('amnus_core.group_amnus_user'))]"/>
        </record>
        <record id="group_amnus_admin" model="res.groups">
            <field name="name">AMNUS Administrator</field>
            <field name="implied_ids" eval="[(4, ref('amnus_core.group_amnus_manager'))]"/>
        </record>

        <!-- ==================== ACCESS RIGHTS (ACL) ==================== -->
        <!-- Defined here (after groups) so group external IDs are resolvable. -->
        <record id="access_amnus_tag_user" model="ir.model.access">
            <field name="name">amnus.tag.user</field>
            <field name="model_id" ref="model_amnus_tag"/>
            <field name="group_id" ref="amnus_core.group_amnus_user"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="access_amnus_tag_manager" model="ir.model.access">
            <field name="name">amnus.tag.manager</field>
            <field name="model_id" ref="model_amnus_tag"/>
            <field name="group_id" ref="amnus_core.group_amnus_manager"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        <record id="access_amnus_tag_admin" model="ir.model.access">
            <field name="name">amnus.tag.admin</field>
            <field name="model_id" ref="model_amnus_tag"/>
            <field name="group_id" ref="amnus_core.group_amnus_admin"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        <record id="access_amnus_audit_log_manager" model="ir.model.access">
            <field name="name">amnus.audit.log.manager</field>
            <field name="model_id" ref="model_amnus_audit_log"/>
            <field name="group_id" ref="amnus_core.group_amnus_manager"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="access_amnus_audit_log_admin" model="ir.model.access">
            <field name="name">amnus.audit.log.admin</field>
            <field name="model_id" ref="model_amnus_audit_log"/>
            <field name="group_id" ref="amnus_core.group_amnus_admin"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
