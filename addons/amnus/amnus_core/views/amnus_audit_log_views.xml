<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_amnus_audit_log" model="ir.actions.act_window">
            <field name="name">AMNUS Audit Logs</field>
            <field name="res_model">amnus.audit.log</field>
            <field name="view_mode">list,form</field>
            <field name="target">current</field>
            <field name="help" type="html">
                <p class="o_view_nocenter_empty_smiley">
                    Audit trail of important AMNUS business operations.
                </p>
            </field>
        </record>

        <record id="view_amnus_audit_log_tree" model="ir.ui.view">
            <field name="name">amnus.audit.log.tree</field>
            <field name="model">amnus.audit.log</field>
            <field name="arch" type="xml">
                <tree string="AMNUS Audit Logs">
                    <field name="date"/>
                    <field name="name"/>
                    <field name="user_id"/>
                    <field name="action"/>
                    <field name="model_name"/>
                    <field name="record_id"/>
                    <field name="company_id"/>
                </tree>
            </field>
        </record>

        <record id="view_amnus_audit_log_form" model="ir.ui.view">
            <field name="name">amnus.audit.log.form</field>
            <field name="model">amnus.audit.log</field>
            <field name="arch" type="xml">
                <form string="AMNUS Audit Log">
                    <sheet>
                        <group>
                            <group>
                                <field name="date" readonly="1"/>
                                <field name="user_id" readonly="1"/>
                                <field name="action" readonly="1"/>
                                <field name="model_name" readonly="1"/>
                                <field name="record_id" readonly="1"/>
                                <field name="company_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="name" readonly="1"/>
                                <field name="description" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_amnus_audit_log_search" model="ir.ui.view">
            <field name="name">amnus.audit.log.search</field>
            <field name="model">amnus.audit.log</field>
            <field name="arch" type="xml">
                <search string="Search Audit Logs">
                    <field name="name"/>
                    <field name="user_id"/>
                    <field name="action"/>
                    <field name="model_name"/>
                    <field name="date"/>
                    <field name="company_id"/>
                    <filter name="today" string="Today" domain="[('date','&gt;=',context_today())]"/>
                    <group expand="0" string="Group By">
                        <field name="user_id"/>
                        <field name="action"/>
                        <field name="model_name"/>
                        <field name="company_id"/>
                    </group>
                </search>
            </field>
        </record>
    </data>
</odoo>
