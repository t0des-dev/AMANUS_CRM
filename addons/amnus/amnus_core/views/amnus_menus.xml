<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- AMNUS root menu -->
        <menuitem id="menu_amnus_root" name="AMNUS" sequence="10"/>

        <!-- Overview (landing page until dashboard addon is implemented) -->
        <menuitem id="menu_amnus_overview" name="Overview" parent="menu_amnus_root" sequence="10"/>

        <!-- Configuration (managers and above) -->
        <menuitem id="menu_amnus_configuration" name="Configuration" parent="menu_amnus_root" sequence="20" groups="amnus_core.group_amnus_manager"/>
        <menuitem id="menu_amnus_tags" name="Tags" parent="menu_amnus_configuration" sequence="10" groups="amnus_core.group_amnus_user"/>
        <menuitem id="menu_amnus_settings" name="Settings" parent="menu_amnus_configuration" sequence="20" groups="amnus_core.group_amnus_admin"/>

        <!-- Administration (managers and above) -->
        <menuitem id="menu_amnus_administration" name="Administration" parent="menu_amnus_root" sequence="30" groups="amnus_core.group_amnus_manager"/>
        <menuitem id="menu_amnus_audit_logs" name="Audit Logs" parent="menu_amnus_administration" sequence="10" groups="amnus_core.group_amnus_manager"/>

        <!-- Actions -->
        <record id="action_amnus_tag" model="ir.actions.act_window">
            <field name="name">AMNUS Tags</field>
            <field name="res_model">amnus.tag</field>
            <field name="view_mode">list,form</field>
            <field name="target">current</field>
        </record>
        <menuitem id="menu_amnus_tags_action" name="Tags" parent="menu_amnus_tags" action="action_amnus_tag" groups="amnus_core.group_amnus_user"/>

        <record id="action_amnus_audit_log" model="ir.actions.act_window">
            <field name="name">AMNUS Audit Logs</field>
            <field name="res_model">amnus.audit.log</field>
            <field name="view_mode">list,form</field>
            <field name="target">current</field>
        </record>
        <menuitem id="menu_amnus_audit_logs_action" name="Audit Logs" parent="menu_amnus_audit_logs" action="action_amnus_audit_log" groups="amnus_core.group_amnus_manager"/>

        <record id="action_amnus_settings" model="ir.actions.act_window">
            <field name="name">AMNUS Settings</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="target">inline</field>
        </record>
        <menuitem id="menu_amnus_settings_action" name="Settings" parent="menu_amnus_settings" action="action_amnus_settings" groups="amnus_core.group_amnus_admin"/>
    </data>
</odoo>
