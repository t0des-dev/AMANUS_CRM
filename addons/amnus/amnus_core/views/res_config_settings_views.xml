<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_amnus_res_config_settings" model="ir.ui.view">
            <field name="name">amnus.res.config.settings.form.inherit</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app data-string="AMNUS" string="AMNUS" name="amnus_core">
                        <block title="AMNUS Core" name="amnus_core_setting_container">
                            <setting id="amnus_enabled" string="AMNUS Enabled" help="Enable or disable the AMNUS platform globally.">
                                <field name="amnus_enabled" widget="boolean_toggle"/>
                            </setting>
                            <setting id="amnus_audit_logging" string="Audit Logging Enabled" help="Enable or disable audit logging for AMNUS business operations.">
                                <field name="amnus_audit_logging" widget="boolean_toggle"/>
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
