#. module: amnus_agile
#. odoo-python
#: code:addons/amnus_agile/models/amnus_agile_user_story.py
msgid "The sprint must belong to the same project and company as the user story."
msgstr ""
"يجب أن ينتمي السبرنت إلى المشروع والشركة نفسيهما اللذين تنتمي إليهما قصة "
"المستخدم."

#. module: amnus_agile
#. odoo-python
#: code:addons/amnus_agile/models/amnus_agile_sprint.py
#: code:addons/amnus_agile/models/amnus_agile_user_story.py
