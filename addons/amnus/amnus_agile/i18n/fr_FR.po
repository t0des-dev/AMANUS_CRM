#: model:ir.model.constraint,message:amnus_agile.constraint_amnus_agile_user_story_task_id_unique
msgid "A project task can only be linked to one user story."
msgstr ""
"Une tâche de projet ne peut être liée qu'à une seule histoire utilisateur."

#. module: amnus_agile
#. odoo-python
#: code:addons/amnus_agile/models/amnus_agile_sprint.py:0
msgid "A sprint cannot carry stories over to itself."
msgstr "Un sprint ne peut pas reporter ses histoires sur lui-même."

#. module: amnus_agile
#. odoo-python
#: code:addons/amnus_agile/models/amnus_agile_membership.py:0
msgid ""
"A sprint membership must link a story and a sprint of the same project and "
"company."
msgstr ""
"Une appartenance à un sprint doit relier une histoire et un sprint du même "
"projet et de la même société."

#. module: amnus_agile
#: model:ir.model.constraint,message:amnus_agile.constraint_amnus_agile_sprint_membership_sprint_story_unique
msgid "A user story can only have one membership record per sprint."
msgstr ""
"Une histoire utilisateur ne peut avoir qu'un seul enregistrement "
"d'appartenance par sprint."

#. module: amnus_agile
#. odoo-python
#: code:addons/amnus_agile/models/amnus_agile_user_story.py:0
msgid "A user story cannot be completed before acceptance criteria are set."
msgstr ""
"Une histoire utilisateur ne peut être terminée avant que les critères "
"d'acceptation ne soient définis."

#. module: amnus_agile
#. odoo-python
#: code:addons/amnus_agile/models/amnus_agile_user_story.py:0
msgid "A user story cannot be created as done without acceptance criteria."
msgstr ""
"Une histoire utilisateur ne peut pas être créée en état terminé sans "
"critères d'acceptation."

#. module: amnus_agile
#. odoo-python
#: code:addons/amnus_agile/models/amnus_agile_membership.py:0
#: code:addons/amnus_agile/models/amnus_agile_user_story.py:0
msgid "A user story cannot belong to two sprints at the same time."
msgstr ""
"Une histoire utilisateur ne peut pas appartenir à deux sprints en même "
"temps."

