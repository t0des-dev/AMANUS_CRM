<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ==================== USER STORY RULES ==================== -->
        <record id="rule_amnus_agile_user_story_company" model="ir.rule">
            <field name="name">AMNUS Agile User Story: multi-company</field>
            <field name="model_id" ref="model_amnus_agile_user_story"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_amnus_agile_user_story_visibility" model="ir.rule">
            <field name="name">AMNUS Agile User Story: project visibility</field>
            <field name="model_id" ref="model_amnus_agile_user_story"/>
            <field name="domain_force">[('project_id.privacy_visibility', 'in', ['employees', 'portal']), '|', ('project_id.message_partner_ids', 'in', [user.partner_id.id]), ('project_id.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="groups" eval="[(4, ref('amnus_agile.group_amnus_agile_user'))]"/>
        </record>

        <record id="rule_amnus_agile_user_story_manager" model="ir.rule">
            <field name="name">AMNUS Agile User Story: agile manager sees all</field>
            <field name="model_id" ref="model_amnus_agile_user_story"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="groups" eval="[(4, ref('amnus_agile.group_amnus_agile_manager'))]"/>
        </record>

