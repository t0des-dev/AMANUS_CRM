<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ==================== AMNUS AGILE SECURITY GROUPS ====================
             Dedicated Agile groups. Implied groups reuse the existing AMNUS project
             groups; no standard Odoo group or AMNUS core group is modified.
        -->
        <record id="group_amnus_agile_user" model="res.groups">
            <field name="name">AMNUS Agile User</field>
            <field name="comment">Use AMNUS Agile planning: backlogs, epics, sprints.</field>
            <field name="implied_ids" eval="[
                (4, ref('amnus_core.group_amnus_user')),
                (4, ref('amnus_projects.group_amnus_project_user')),
            ]"/>
        </record>

        <record id="group_amnus_agile_manager" model="res.groups">
            <field name="name">AMNUS Agile Manager</field>
            <field name="comment">Manage AMNUS Agile backlogs, epics, sprints and metrics.</field>
            <field name="implied_ids" eval="[
                (4, ref('amnus_agile.group_amnus_agile_user')),
                (4, ref('amnus_projects.group_amnus_project_manager')),
            ]"/>
        </record>

        <record id="group_amnus_agile_admin" model="res.groups">
            <field name="name">AMNUS Agile Administrator</field>
            <field name="comment">Full AMNUS Agile administration.</field>
            <field name="implied_ids" eval="[(4, ref('amnus_agile.group_amnus_agile_manager'))]"/>
        </record>
    </data>
</odoo>
