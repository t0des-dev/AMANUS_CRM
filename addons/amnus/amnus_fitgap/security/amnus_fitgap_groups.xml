<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ==================== AMNUS FIT-GAP SECURITY GROUPS ==================== -->
        <record id="group_amnus_fitgap_user" model="res.groups">
            <field name="name">AMNUS Fit-Gap User</field>
            <field name="comment">Use AMNUS Fit-Gap: view assessments and evidence.</field>
            <field name="implied_ids" eval="[
                (4, ref('amnus_core.group_amnus_user')),
                (4, ref('amnus_analysis.group_amnus_analysis_user')),
            ]"/>
        </record>

        <record id="group_amnus_fitgap_manager" model="res.groups">
            <field name="name">AMNUS Fit-Gap Manager</field>
            <field name="comment">Manage AMNUS Fit-Gap assessments, reviews and approvals.</field>
            <field name="implied_ids" eval="[
                (4, ref('amnus_fitgap.group_amnus_fitgap_user')),
                (4, ref('amnus_analysis.group_amnus_analysis_manager')),
            ]"/>
        </record>

        <record id="group_amnus_fitgap_admin" model="res.groups">
            <field name="name">AMNUS Fit-Gap Administrator</field>
            <field name="comment">Full AMNUS Fit-Gap administration.</field>
            <field name="implied_ids" eval="[(4, ref('amnus_fitgap.group_amnus_fitgap_manager'))]"/>
        </record>
    </data>
</odoo>
