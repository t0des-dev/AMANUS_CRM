<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ==================== ASSESSMENT RECORD RULES ==================== -->
        <record id="rule_amnus_fitgap_assessment_company" model="ir.rule">
            <field name="name">AMNUS Fit-Gap Assessment: multi-company</field>
            <field name="model_id" ref="model_amnus_fitgap_assessment"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_amnus_fitgap_assessment_visibility" model="ir.rule">
            <field name="name">AMNUS Fit-Gap Assessment: project visibility</field>
            <field name="model_id" ref="model_amnus_fitgap_assessment"/>
            <field name="domain_force">[
                '|',
                    ('project_id.privacy_visibility', 'in', ['employees', 'portal']),
                '|',
                    ('project_id.message_partner_ids', 'in', [user.partner_id.id]),
                    '|',
                        ('project_id.user_id', '=', user.id),
                        ('assessor_id', '=', user.id),
            ]</field>
            <field name="groups" eval="[(4, ref('amnus_fitgap.group_amnus_fitgap_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_amnus_fitgap_assessment_manager" model="ir.rule">
            <field name="name">AMNUS Fit-Gap Assessment: fitgap manager sees all</field>
            <field name="model_id" ref="model_amnus_fitgap_assessment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="groups" eval="[(4, ref('amnus_fitgap.group_amnus_fitgap_manager'))]"/>
        </record>

        <!-- ==================== VERSION RECORD RULES ==================== -->
        <record id="rule_amnus_fitgap_assessment_version_company" model="ir.rule">
            <field name="name">AMNUS Fit-Gap Assessment Version: multi-company</field>
            <field name="model_id" ref="model_amnus_fitgap_assessment_version"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_amnus_fitgap_assessment_version_visibility" model="ir.rule">
            <field name="name">AMNUS Fit-Gap Assessment Version: project visibility</field>
            <field name="model_id" ref="model_amnus_fitgap_assessment_version"/>
            <field name="domain_force">[('assessment_id.project_id.privacy_visibility', 'in', ['employees', 'portal']), '|', ('assessment_id.project_id.message_partner_ids', 'in', [user.partner_id.id]), '|', ('assessment_id.project_id.user_id', '=', user.id), ('assessment_id.assessor_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('amnus_fitgap.group_amnus_fitgap_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_amnus_fitgap_assessment_version_manager" model="ir.rule">
            <field name="name">AMNUS Fit-Gap Assessment Version: fitgap manager sees all</field>
            <field name="model_id" ref="model_amnus_fitgap_assessment_version"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="groups" eval="[(4, ref('amnus_fitgap.group_amnus_fitgap_manager'))]"/>
        </record>
    </data>
</odoo>
