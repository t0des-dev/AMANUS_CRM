<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ==================== TASK FORM ==================== -->
        <record id="view_task_form2_amnus" model="ir.ui.view">
            <field name="name">project.task.form.amnus</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='project_id']" position="after">
                    <field name="amnus_deliverable_id"
                           groups="amnus_projects.group_amnus_project_user"
                           domain="[('project_id', '=', project_id)]"
                           options="{'no_create': True}"
                           invisible="not project_id"/>
                </xpath>
            </field>
        </record>

        <!-- ==================== TASK SEARCH ==================== -->
        <record id="view_task_search_form_amnus" model="ir.ui.view">
            <field name="name">project.task.search.form.amnus</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_search_form"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='my_tasks']" position="after">
                    <filter string="AMNUS Deliverable Tasks" name="amnus_deliverable_tasks"
                            domain="[('amnus_deliverable_id', '!=', False)]"
                            groups="amnus_projects.group_amnus_project_user"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
