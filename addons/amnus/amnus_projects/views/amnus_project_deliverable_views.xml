<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ==================== DELIVERABLE LIST ==================== -->
        <record id="view_amnus_project_deliverable_list" model="ir.ui.view">
            <field name="name">amnus.project.deliverable.list</field>
            <field name="model">amnus.project.deliverable</field>
            <field name="arch" type="xml">
                <list string="Deliverables" decoration-muted="state == 'draft'">
                    <field name="name"/>
                    <field name="project_id"/>
                    <field name="type"/>
                    <field name="responsible_id" widget="many2one_avatar_user"/>
                    <field name="due_date" decoration-danger="due_date and due_date &lt; current_date and state not in ('accepted',)"/>
                    <field name="task_count"/>
                    <field name="state" widget="badge"
                           decoration-info="state == 'draft'"
                           decoration-warning="state == 'submitted'"
                           decoration-success="state == 'accepted'"
                           decoration-danger="state == 'rejected'"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <!-- ==================== DELIVERABLE FORM ==================== -->
        <record id="view_amnus_project_deliverable_form" model="ir.ui.view">
            <field name="name">amnus.project.deliverable.form</field>
            <field name="model">amnus.project.deliverable</field>
            <field name="arch" type="xml">
                <form string="Deliverable">
                    <header>
                        <button name="action_submit" type="object" string="Submit"
                                class="btn-primary"
                                groups="amnus_projects.group_amnus_project_user"
                                invisible="state not in ('draft', 'rejected')"/>
                        <button name="action_accept" type="object" string="Accept"
                                class="btn-primary"
                                groups="amnus_projects.group_amnus_project_manager"
                                invisible="state != 'submitted'"/>
                        <button name="action_reject" type="object" string="Reject"
                                class="btn-secondary"
                                groups="amnus_projects.group_amnus_project_manager"
                                invisible="state != 'submitted'"/>
                        <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                                class="btn-secondary"
                                groups="amnus_projects.group_amnus_project_manager"
                                invisible="state not in ('submitted', 'rejected')"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,submitted,accepted"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" type="object" name="action_view_tasks"
                                    icon="fa-check">
                                <field name="task_count" widget="statinfo" string="Tasks"/>
                            </button>
                        </div>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                                invisible="active"/>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="e.g. Signed functional specification"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="project_id"
                                       options="{'no_create': True}"/>
                                <field name="type"/>
                                <field name="responsible_id" widget="many2one_avatar_user"/>
                                <field name="due_date"/>
                            </group>
                            <group>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="tag_ids" widget="many2many_tags"
                                       options="{'color_field': 'color'}"/>
                                <field name="active" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Description" name="description">
                                <field name="description" placeholder="Describe the expected output and acceptance criteria..."/>
                            </page>
                            <page string="Sign-off" name="sign_off">
                                <group>
                                    <group string="Submission">
                                        <field name="submitted_by" readonly="1"/>
                                        <field name="submitted_date" readonly="1"/>
                                    </group>
                                    <group string="Decision">
                                        <field name="accepted_by" readonly="1"/>
                                        <field name="accepted_date" readonly="1"/>
                                        <field name="rejected_by" readonly="1"/>
                                        <field name="rejected_date" readonly="1"/>
                                    </group>
                                </group>
                                <field name="rejection_reason"
                                       readonly="state != 'submitted'"
                                       placeholder="Required when rejecting a deliverable"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- ==================== DELIVERABLE SEARCH ==================== -->
        <record id="view_amnus_project_deliverable_search" model="ir.ui.view">
            <field name="name">amnus.project.deliverable.search</field>
            <field name="model">amnus.project.deliverable</field>
            <field name="arch" type="xml">
                <search string="Search Deliverables">
                    <field name="name"/>
                    <field name="project_id"/>
                    <field name="responsible_id"/>
                    <field name="type"/>
                    <field name="tag_ids"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <filter string="My Deliverables" name="my_deliverables"
                            domain="[('responsible_id', '=', uid)]"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                    <filter string="Accepted" name="accepted" domain="[('state', '=', 'accepted')]"/>
                    <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                    <separator/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                    <group>
                        <filter string="Project" name="groupby_project"
                                context="{'group_by': 'project_id'}"/>
                        <filter string="Responsible" name="groupby_responsible"
                                context="{'group_by': 'responsible_id'}"/>
                        <filter string="Status" name="groupby_state"
                                context="{'group_by': 'state'}"/>
                        <filter string="Type" name="groupby_type"
                                context="{'group_by': 'type'}"/>
                        <filter string="Company" name="groupby_company"
                                context="{'group_by': 'company_id'}"
                                groups="base.group_multi_company"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ==================== DELIVERABLE ACTION ==================== -->
        <record id="action_amnus_project_deliverables" model="ir.actions.act_window">
            <field name="name">Deliverables</field>
            <field name="res_model">amnus.project.deliverable</field>
            <field name="view_mode">list,form</field>
            <field name="target">current</field>
            <field name="context">{'search_default_my_deliverables': 0}</field>
            <field name="help" type="html">
                <p class="o_view_nocenter_empty_smiley">
                    Track the contractual outputs of your implementation projects.
                </p>
                <p>
                    A deliverable is submitted by its responsible, then accepted or rejected
                    by an AMNUS Project Manager. Sign-off identity and dates are recorded
                    server-side.
                </p>
            </field>
        </record>
    </data>
</odoo>
