msgid "<span class=\"o_stat_text\">Implementation Request</span>"
msgstr "<span class=\"o_stat_text\">Demande de mise en œuvre</span>"

#. module: amnus_projects
msgid ""
"A deliverable is submitted by its responsible, then accepted or rejected\n"
"                    by an AMNUS Project Manager. Sign-off identity and dates are recorded\n"
"                    server-side."
msgstr ""
"Un livrable est soumis par son responsable, puis accepté ou refusé\n"
"                    par un Gestionnaire de projet AMNUS. L'identité et les dates de validation sont enregistrées\n"
"                    côté serveur."

